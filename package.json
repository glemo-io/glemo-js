{
  "name": "glemo-js",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The official Glemo JavaScript and TypeScript SDK and verification widget.",
  "license": "MIT",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:pack": "pnpm -r check:pack",
    "sync:openapi": "node scripts/sync-openapi.mjs",
    "build:openapi": "node scripts/build-public-openapi.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "check:release": "node scripts/check-release-workflow.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.5",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.1",
    "jsdom": "^30.0.0",
    "publint": "^0.3.22",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
